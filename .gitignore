# Personal planning, roadmaps and strategy notes — not part of the shipped project
/.planning/

# Build output
/bin/
/dist/

# Scratch output from local chaos runs. Runs worth keeping go in
# docs/chaos-runs/ instead, because a recorded history is the evidence a run
# produced and a result nobody can inspect afterwards is only an assertion.
/.chaos-runs/

# Test & simulation artifacts
*.out
*.test
/coverage.*
/testdata/tmp/
/sim-failures/

# Node data directories produced by raftd
/data/
*.bolt

# Local environment
.env
.DS_Store

# Editor
.idea/
*.swp
